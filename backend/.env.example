ENVIRONMENT=development
DEBUG=true
CAREPATH_USE_SQLITE=1
SECRET_KEY=change-me-in-production

# CORS – comma-separated origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Telegram (primary messaging channel for demo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=carepath-tg-secret

# WhatsApp Cloud API (optional – when Meta is ready)
WHATSAPP_VERIFY_TOKEN=carepath-verify-token-change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

CLINICIAN_API_KEY=carepath-clinician-dev-key
RULES_VERSION=2026-11-prototype-v0.1
